{
  "name": "@runminton/pi-async-bash",
  "version": "0.1.0",
  "description": "Automatically hand long-running pi bash commands to a managed background task and resume the session when it finishes.",
  "type": "module",
  "license": "MIT",
  "author": "RunMintOn",
  "homepage": "https://github.com/RunMintOn/pi-async-bash#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RunMintOn/pi-async-bash.git"
  },
  "bugs": {
    "url": "https://github.com/RunMintOn/pi-async-bash/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "bash",
    "async",
    "background-task"
  ],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  }
}
