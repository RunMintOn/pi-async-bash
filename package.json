{
  "name": "@runminton/pi-async-bash",
  "version": "0.1.2",
  "description": "Codex-style shell sessions for pi, with bounded waits, stdin and optional PTY.",
  "type": "module",
  "license": "MIT",
  "author": "RunMintOn",
  "homepage": "https://github.com/RunMintOn/pi-async-bash#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RunMintOn/pi-async-bash.git"
  },
  "bugs": {
    "url": "https://github.com/RunMintOn/pi-async-bash/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "bash",
    "async",
    "background-task"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "scripts/setup-pty.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/setup-pty.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  }
}
